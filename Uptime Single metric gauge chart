   and name !in ["ALUSFW-L30176","ALUSFW-L32593","ALUSFW-L27396","ALUSFW-L30683","ALUSFW-L33736","ALUSFW-L33067","ALUSFW-L32342","ALUSFW-L27650","ALUSFW-L34319","ALUSFW-L34317","ALUSFW-L31244","ALUSFW-L32848","ALUSFW-L29730","ALUSFW-L29109","ALCHVE-MHT9447M","ALUSFW-L31339","ALCHVE-L00294","ALUSFW-L34812","ALUSFW-L31101","ALUSFW-L29060","ALUSFW-L31518","ALUSFW-L31361","ALUSFW-L31348","ALUSFW-L34318","ALUSFW-L29732","ALUSFW-L31541","ALUSFW-L34004","ALUSFW-MDVJMGIK"]
