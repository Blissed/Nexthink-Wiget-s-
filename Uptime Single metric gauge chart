| where hardware.type != virtual
   and hardware.type in [laptop, desktop]
   and name in ["alusfw-w*", "alusfw-l*"]
   and name !in ["alusfw-wl*", "alusfw-ll*", "alusfw-wd*","alusfw-Ld*", "alusfw-wr*", "alusfw-lr*", "alusfw-wt*", "alusfw-lt*","alusfw-wi*","alusfw-li*"]
